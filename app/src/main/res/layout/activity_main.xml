<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8F4">

    <!-- Welcome header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#2E7D32">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMART PANTRY"
            android:textColor="#C8E6C9"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Make the most of what you have."
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:paddingTop="6dp" />
    </LinearLayout>

    <!-- Main actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/btnAddIngredient"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="+  Add Ingredient"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnSuggestedRecipes"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Explore Suggested Recipes"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:backgroundTint="#E1F0E2"
            android:textColor="#25652A" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:text="Settings"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:backgroundTint="#F4F8F4"
            android:textColor="#2E7D32" />
    </LinearLayout>

    <!-- Pantry list -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:padding="16dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Pantry"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#205C29" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your ingredients in one place"
            android:textSize="13sp"
            android:textColor="#718071"
            android:paddingTop="3dp"
            android:paddingBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0EAE0" />

        <ListView
            android:id="@+id/listPantry"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:divider="#E5EEE5"
            android:dividerHeight="1dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

</LinearLayout>
