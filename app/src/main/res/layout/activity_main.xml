<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:paddingBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage ingredients. Reduce food waste."
        android:textSize="14sp"
        android:textColor="#558B5A"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add Ingredient"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:backgroundTint="#E8F5E9"
        android:textColor="#2E7D32" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />

    <ListView
        android:id="@+id/listPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#C8E6C9"
        android:dividerHeight="1dp"
        android:paddingBottom="8dp" />

</LinearLayout>