<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:paddingBottom="24dp" />

    <Switch
        android:id="@+id/switchExpiryAlerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable expiry alerts"
        android:textSize="17sp"
        android:textColor="#333333"
        android:thumbTint="#2E7D32"
        android:trackTint="#A5D6A7" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Control whether the app should enable expiry-related alerts."
        android:textColor="#558B5A"
        android:paddingTop="8dp"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/btnBackSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Pantry"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF" />

</LinearLayout>