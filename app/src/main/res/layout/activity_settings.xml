<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F4F8F4">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PREFERENCES"
        android:textColor="#43864A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="29sp"
        android:textStyle="bold"
        android:textColor="#205C29"
        android:paddingTop="5dp"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Personalise how you manage your pantry."
        android:textSize="14sp"
        android:textColor="#687B69"
        android:paddingBottom="22dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Food expiry"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#205C29"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry alerts"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#344A35" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turn this option on or off to save your expiry-alert preference."
            android:textSize="14sp"
            android:textColor="#718071"
            android:paddingTop="6dp"
            android:paddingBottom="16dp" />

        <Switch
            android:id="@+id/switchExpiryAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable expiry alerts"
            android:textSize="15sp"
            android:textColor="#205C29"
            android:thumbTint="#2E7D32"
            android:trackTint="#A5D6A7" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your preference is saved by the app."
        android:textSize="12sp"
        android:textColor="#718071"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnBackSettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Back to My Pantry"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF" />

</LinearLayout>
